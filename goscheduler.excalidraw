      "text": "- for every thread, Go runtime will create\nP (logical processor)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- for every thread, Go runtime will create P (logical processor)",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "V0hz4Ph1mmftFFTI4NBK5",
      "type": "text",
      "x": -6503.810807802449,
