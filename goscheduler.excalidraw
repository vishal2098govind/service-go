    },
    {
      "id": "CC3wwxDUt0M1vxsCHfafh",
      "type": "text",
      "x": -1423.5910530338283,
      "y": 2860.5330764076,
      "width": 105.62393188476562,
      "height": 30.57146389719838,
      "angle": 0,
      "strokeColor": "#1e1e1e",
