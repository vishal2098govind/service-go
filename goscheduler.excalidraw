      "isDeleted": false,
      "boundElements": [],
      "updated": 1768414209600,
      "link": null,
      "locked": false,
      "text": "- when the go program starts up, the Go runtime\nasks the underlying machine\n\"How many CPU cores are available for me\"",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- when the go program starts up, the Go runtime asks the underlying machine\n\"How many CPU cores are available for me\"",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "x0eXTg4djHfqqafM7vKbt",
      "type": "text",
      "x": -7198.682372171586,
      "y": 1250.461371438637,
      "width": 478.8063354492187,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aE",
      "roundness": null,
      "seed": 1555295723,
      "version": 359,
      "versionNonce": 448946725,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1768414209600,
      "link": null,
      "locked": false,
      "text": "- say we have 4 CPU cores",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- say we have 4 CPU cores",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "aWn0OTNAYMyuZlSFTDzPR",
      "type": "text",
      "x": -7198.682372171586,
      "y": 1291.653265969887,
      "width": 478.8063354492187,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aF",
      "roundness": null,
      "seed": 656880939,
      "version": 460,
      "versionNonce": 719115653,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1768414209601,
      "link": null,
      "locked": false,
      "text": "- Go runtime will create 4 OS threads to run Go-\nroutines against those OS threads",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Go runtime will create 4 OS threads to run Go-routines against those OS threads",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "aThTyjyksQkvvapULNNuN",
      "type": "text",
      "x": -7198.682372171586,
      "y": 1359.6392584015275,
      "width": 478.8063354492187,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
